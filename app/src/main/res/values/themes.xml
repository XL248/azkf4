<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 实验要求：主题继承 Theme.MaterialComponents.DayNight.DarkActionBar.Bridge -->
    <style name="Base.Theme.Azshiyan4" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <style name="Theme.Azshiyan4" parent="Base.Theme.Azshiyan4" />

    <!-- 信息行左侧标签 -->
    <style name="Widget.Azshiyan4.RowLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 信息行右侧内容 -->
    <style name="Widget.Azshiyan4.RowValue" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
